# ORGANICHY — copy to `.env` and edit. Read automatically by lib/config.js (no dotenv needed).

# HTTP port (Render injects its own)
PORT=3000

# Canonical URL used for SEO tags, sitemap and emails. No trailing slash.
SITE_URL=http://localhost:3000

# Admin console password for /admin — CHANGE THIS BEFORE LAUNCH.
ADMIN_PASSWORD=organichy@2026

# Razorpay. Leave both empty to stay in DEMO mode (nothing is charged).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional overrides
DATA_DIR=
FREE_SHIPPING_THRESHOLD=899
SHIPPING_FEE=49
COD_FEE=29
ENABLE_COD=true
WHATSAPP_NUMBER=919876543210
